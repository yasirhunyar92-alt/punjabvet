{
  "version": 2,
  "builds": [
    {
      "src": "api/sitemap.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/sitemap(-\\d+)?\\.xml",
      "dest": "/api/sitemap.ts",
      "methods": ["GET"]
    },
    {
      "src": "/robots\\.txt",
      "dest": "/public/robots.txt",
      "methods": ["GET"]
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.ts",
      "methods": ["GET"]
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200
    }
  ],
  "env": {
    "VITE_SUPABASE_URL": "@VITE_SUPABASE_URL",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "@VITE_SUPABASE_PUBLISHABLE_KEY",
    "VITE_SUPABASE_PROJECT_ID": "@VITE_SUPABASE_PROJECT_ID",
    "SUPABASE_SERVICE_KEY": "@SUPABASE_SERVICE_KEY",
    "SITE_URL": "@SITE_URL"
  }
}
